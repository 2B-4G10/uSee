{
  "schema": 1,
  "policy": {
    "default": "deny",
    "readOnlyTools": [
      "ruview_onboard",
      "ruview_claim_check",
      "ruview_verify",
      "ruview_node_monitor",
      "ruview_guidance",
      "ruview_memory_search",
      "ruview_kernel_selftest",
      "ruview_doctor",
      "ruview_firmware_plan",
      "ruview_firmware_ports",
      "ruview_train_plan",
      "ruview_train_gate"
    ],
    "grants": {
      "credential-use": {
        "tools": [
          "ruview_spaces_list"
        ],
        "requiresConfirmation": false,
        "notes": "Allows a tenant-scoped external read; OAuth refresh may rotate the local credential file."
      },
      "workspace-write": {
        "tools": [
          "ruview_calibrate",
          "ruview_train"
        ],
        "requiresConfirmation": true
      },
      "hardware-write": {
        "tools": [
          "ruview_node_flash"
        ],
        "requiresConfirmation": true
      }
    },
    "agentHosts": {
      "defaultMode": "read-only",
      "writeRequires": [
        "allow-write",
        "confirm"
      ],
      "forbiddenFlags": [
        "dangerously-skip-permissions",
        "dangerously-bypass-approvals-and-sandbox"
      ]
    }
  }
}
